{
  "name": "bradly-client",
  "version": "2.0.0",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.bradlystronghold.app",
    "productName": "BradlyStronghold",
    "win": { "target": "portable" },
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron.js", "preload.js"]
  }
}
